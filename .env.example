# --- Grok (xAI) API -------------------------------------------------
# Get a key at https://console.x.ai  Without a key, HiveMind runs in
# offline mock mode: the full pipeline still executes with simulated
# personas and behaviors (great for demos and tests).
XAI_API_KEY=

# Model used for persona generation, agent driving, and analysis.
# grok-4.7 is the frontier model; grok-4.3 is a cheaper option.
HIVEMIND_MODEL=grok-4.7

# auto | mock | grok   (auto = grok when XAI_API_KEY is set, else mock)
HIVEMIND_MODE=auto

# --- Runtime ---------------------------------------------------------
HIVEMIND_MAX_STEPS=30
HIVEMIND_BUDGET_SECONDS=240
# Send screenshots to Grok (vision). Set false for a DOM-only, cheaper loop.
HIVEMIND_VISION=true
HIVEMIND_HEADLESS=true
# Default cohort size for `cli.py run` without --personas
HIVEMIND_PERSONAS=3

# --- Cost controls (X Search is billed per fetched post) --------------
# How many days back Phase 1 may search X.
HIVEMIND_SEARCH_DAYS=7
# Max internal search rounds per Phase-1 call (lower = cheaper, less grounded).
HIVEMIND_SEARCH_MAX_TURNS=4
# Screenshots attached to each Phase-3 review (0 = text only).
HIVEMIND_ANALYST_SHOTS=3
